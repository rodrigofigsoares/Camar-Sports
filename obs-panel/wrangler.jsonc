{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obs-panel",
  "account_id": "27a4919449d5bd8197efa3755eb0c707",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "services": [{"binding":"CAMAR","service":"cloud-overlays"}],
  "observability": {"enabled":true,"logs":{"enabled":true,"head_sampling_rate":0.1},"traces":{"enabled":true,"head_sampling_rate":0.01}}
}
