{
  "name": "cloud-overlays",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "start": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "esbuild worker/index.ts --bundle --format=esm --platform=browser --external:cloudflare:workers --outfile=.wrangler/build/index.js && vitest run",
    "db:local": "wrangler d1 migrations apply cloud-overlays-db --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "wrangler": "^4.136.3",
    "miniflare": "5.20260921.0-alpha",
    "esbuild": "0.25.12"
  }
}
